{
  "manifest_version": 3,
  "name": "BOSS 求职降噪助手",
  "version": "0.5.15",
  "key": "",
  "description": "在 BOSS 直聘职位列表页和消息页同步本地求职状态，并提供独立数据面板。",
  "action": {
    "default_title": "BOSS 求职降噪助手",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://zhipin.com/*",
    "https://zhipin.com/*",
    "http://*.zhipin.com/*",
    "https://*.zhipin.com/*",
    "http://bosszhipin.com/*",
    "https://bosszhipin.com/*",
    "http://*.bosszhipin.com/*",
    "https://*.bosszhipin.com/*",
    "http://kanzhun.com/*",
    "https://kanzhun.com/*",
    "http://*.kanzhun.com/*",
    "https://*.kanzhun.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://zhipin.com/*",
        "https://zhipin.com/*",
        "http://*.zhipin.com/*",
        "https://*.zhipin.com/*",
        "http://bosszhipin.com/*",
        "https://bosszhipin.com/*",
        "http://*.bosszhipin.com/*",
        "https://*.bosszhipin.com/*",
        "http://kanzhun.com/*",
        "https://kanzhun.com/*",
        "http://*.kanzhun.com/*",
        "https://*.kanzhun.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
